import ui.Widget
import ui.Column
import ui.CrossAlignment
import ui.Text
import ui.button
import ui.desktop.DesktopApp
import ui.desktop.runApp

class Counter implements Widget {
  private Integer clicks = 0
  Widget build() {
    Column(gap: 12.0, cross: CrossAlignment.Stretch) {
      Text(text: "Clicks: ${clicks}")
      button(text: "Click me", action: () { clicks = clicks + 1 })
    }
  }
}

Module module() {
  module(dependencies: [dependency(repository: "github", name: "ui", version: 9), dependency(repository: "github", name: "ui.desktop", version: 7)])
}

Void main() { runApp(DesktopApp(title: "Norm UI", home: Counter())) }
