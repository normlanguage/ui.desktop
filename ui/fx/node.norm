package ui.fx

import std.core.Exception
import std.io.Resource
import fx.base.Observable
import fx.base.fxCollectionsSort
import fx.graphics.Node
import fx.graphics.Pane
import fx.graphics.Priority
import fx.graphics.hBoxSetHgrow
import fx.controls.Button
import fx.controls.TextField
import fx.controls.TextArea
import fx.controls.CheckBox
import fx.controls.Labeled
import fx.controls.ScrollPane

public class FxNode implements Resource {
  private FxApplication application
  private Boolean managed
  private Node peer
  private Function<Void()>? action
  private Function<Void(String)>? edit
  private Function<Void(Boolean)>? toggle
  private Function<Void(Observable?)>? listener
  private Boolean synchronizing
  private Boolean closed
  private String roleClass

  FxNode(FxApplication application, Node node, Boolean managed = true) {
    this.application = application
    this.managed = managed
    this.peer = node
    action = null
    edit = null
    toggle = null
    listener = null
    synchronizing = false
    closed = false
    roleClass = ""
    if !managed { return }
    switch node {
      case Button button {
        button.setOnAction((event) { application.dispatch(() {
          var callback = action
          if callback != null { callback() }
        }) })
      }
      case TextField input {
        input.setMaxWidth(1.7976931348623157E308)
        hBoxSetHgrow(arg0: input, arg1: Priority.ALWAYS)
        input.setOnAction((event) { application.dispatch(() {
          var callback = action
          if callback != null { callback() }
        }) })
        listener = (observable) {
          var value = input.getText()!!
          var callback = edit
          if !synchronizing && callback != null { application.dispatch(() { callback(value) }) }
        }
        Observable property = input.textProperty()!!
        property.addListener(listener)
      }
      case TextArea input {
        input.setMaxWidth(1.7976931348623157E308)
        input.setWrapText(true)
        hBoxSetHgrow(arg0: input, arg1: Priority.ALWAYS)
        listener = (observable) {
          var value = input.getText()!!
          var callback = edit
          if !synchronizing && callback != null { application.dispatch(() { callback(value) }) }
        }
        Observable property = input.textProperty()!!
        property.addListener(listener)
      }
      case CheckBox checkbox {
        checkbox.setMaxWidth(1.7976931348623157E308)
        hBoxSetHgrow(arg0: checkbox, arg1: Priority.ALWAYS)
        listener = (observable) {
          var value = checkbox.isSelected()
          var callback = toggle
          if !synchronizing && callback != null { application.dispatch(() { callback(value) }) }
        }
        Observable property = checkbox.selectedProperty()!!
        property.addListener(listener)
      }
      case _ {}
    }
  }

  Node node() { peer }
  public Node nativeNode() { peer }
  public Void dispatch(Function<Void()> callback) {
    checkFxThread()
    if !closed { application.dispatch(callback) }
  }
  public Void focus() { this.checkOpen() peer.requestFocus() }
  public String readText() {
    this.checkOpen()
    switch peer {
      case TextField input { return input.getText()!! }
      case TextArea input { return input.getText()!! }
      case _ { throw Exception(message: "node is not a text field") }
    }
  }
  public Void clear() {
    this.checkOpen()
    switch peer {
      case TextField input { input.clear() }
      case TextArea input { input.clear() }
      case _ { throw Exception(message: "node is not a text field") }
    }
  }
  public Void enabled(Boolean enabled) { this.checkOpen() peer.setDisable(!enabled) }
  public Void text(String text) {
    this.checkOpen()
    switch peer {
      case TextField input {
        if input.getText() == text { return }
        synchronizing = true
        try { input.setText(text) } finally { synchronizing = false }
      }
      case TextArea input {
        if input.getText() == text { return }
        synchronizing = true
        try { input.setText(text) } finally { synchronizing = false }
      }
      case Labeled label { label.setText(text) label.setWrapText(true) }
      case _ { throw Exception(message: "node does not display text") }
    }
  }
  public Void placeholder(String text) {
    this.checkOpen()
    switch peer {
      case TextField input { input.setPromptText(text) }
      case TextArea input { input.setPromptText(text) }
      case _ { throw Exception(message: "node is not a text field") }
    }
  }
  public Void checked(Boolean selected) {
    this.checkOpen()
    switch peer {
      case CheckBox checkbox {
        synchronizing = true
        try { checkbox.setSelected(selected) } finally { synchronizing = false }
      }
      case _ { throw Exception(message: "node is not a checkbox") }
    }
  }
  public Void textAreaConfiguration(Integer rows, Boolean editable) {
    this.checkOpen()
    switch peer {
      case TextArea input { input.setPrefRowCount(rows) input.setEditable(editable) }
      case _ { throw Exception(message: "node is not a text area") }
    }
  }
  public Void onAction(Function<Void()> callback) { this.checkOpen() action = callback }
  public Void onText(Function<Void(String)> callback) { this.checkOpen() edit = callback }
  public Void onToggle(Function<Void(Boolean)> callback) { this.checkOpen() toggle = callback }
  public Void appearance(String role, String key) {
    this.checkOpen()
    peer.setId(key)
    var next = "norm-" + role
    if roleClass != next {
      var styles = peer.getStyleClass()!!
      styles.remove(roleClass)
      styles.add(next)
      roleClass = next
    }
  }
  public Void children(List<FxNode> children) {
    this.checkOpen()
    if !managed {
      if children.size() != 0 { throw Exception(message: "borrowed node manages its own children") }
      return
    }
    switch peer {
      case ScrollPane scroll {
        if children.size() != 1 { throw Exception(message: "scroll view requires one child") }
        var child = children[0].node()
        if scroll.getContent() != child { scroll.setContent(child) }
      }
      case Pane pane {
        Map<Node, Integer> positions = Map<>()
        var existing = pane.getChildren()!!
        Integer position = 0
        for child : children {
          positions[child.node()] = position
          position = position + 1
        }
        var index = existing.size() - 1
        for index >= 0 {
          if !positions.containsKey(existing.get(index)!!) { existing.remove(index) }
          index = index - 1
        }
        for child : children { if !existing.contains(child.node()) { existing.add(child.node()) } }
        fxCollectionsSort<Node>(arg0: existing, arg1: (left, right) {
          positions[left!!]!! - positions[right!!]!!
        })
      }
      case _ { if children.size() != 0 { throw Exception(message: "leaf node cannot contain children") } }
    }
  }
  public Void close() {
    checkFxThread()
    if closed { return }
    closed = true
    if !managed { return }
    action = null
    edit = null
    toggle = null
    switch peer {
      case TextArea input {
        Observable property = input.textProperty()!!
        property.removeListener(listener)
      }
      case Pane pane {
        var children = pane.getChildren()!!
        children.clear()
      }
      case ScrollPane scroll { scroll.setContent(null) }
      case Button button { button.setOnAction(null) }
      case TextField input {
        input.setOnAction(null)
        Observable property = input.textProperty()!!
        property.removeListener(listener)
      }
      case CheckBox checkbox {
        Observable property = checkbox.selectedProperty()!!
        property.removeListener(listener)
      }
      case _ {}
    }
    listener = null
  }
  private Void checkOpen() {
    checkFxThread()
    if closed { throw Exception(message: "GUI node is closed") }
  }
}
