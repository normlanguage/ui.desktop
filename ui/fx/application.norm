package ui.fx

import std.core.Exception
import std.core.Unit
import std.concurrent.Completion
import std.concurrent.Task
import ui.UiTaskTracker
import std.concurrent.completion
import std.context.currentContext
import ui.fx.native.Stage
import ui.fx.native.Node
import ui.fx.native.Scene
import ui.fx.native.StackPane
import ui.fx.native.stageNew
import ui.fx.native.stackPaneNew
import ui.fx.native.sceneNew
import ui.fx.native.platformRunLater
import ui.fx.native.platformIsFxApplicationThread
import ui.fx.native.Alert
import ui.fx.native.AlertAlertType
import ui.fx.native.alertNew
import ui.fx.native.labelNew
import ui.fx.native.buttonNew
import ui.fx.native.textFieldNew
import ui.fx.native.textAreaNew
import ui.fx.native.checkBoxNew

public class FxApplication {
  private String title
  private Double width
  private Double height
  private String? stylesheet
  private Completion<Unit> finished
  private Stage? stage
  private Scene? activeScene
  private StackPane? container
  private Function<Void()>? cleanupAction
  private UiTaskTracker terminations
  private List<Alert> errors
  private Function<Boolean()>? closeRequested = null
  private Boolean closing
  private Boolean started

  FxApplication(String title, String? stylesheet = null, Double width = 760.0, Double height = 680.0) {
    this.title = title
    require(condition: width > 0.0 && height > 0.0, message: "Window dimensions must be positive")
    this.width = width
    this.height = height
    this.stylesheet = stylesheet
    finished = completion<Unit>()
    stage = null
    activeScene = null
    container = null
    cleanupAction = null
    terminations = UiTaskTracker(dispatch: (action) { platformRunLater(action) })
    errors = List<>()
    closing = false
    started = false
  }

  public Void run(Function<Void()> build, Function<Void()> dispose) {
    if platformIsFxApplicationThread() { throw Exception(message: "GUI run requires a non-UI thread") }
    if currentContext<FxRuntime>() == null {
      withFxRuntime(() { this.run(build: build, dispose: dispose) })
      return
    }
    if started { throw Exception(message: "GUI application has already run") }
    started = true
    cleanupAction = dispose
    var task = finished.task()
    try {
      this.later(() {
        var window = stageNew()
        stage = window
        var pane = stackPaneNew()
        container = pane
        var scene = sceneNew(arg0: pane, arg1: width, arg2: height)
        activeScene = scene
        var source = stylesheet
        if source != null { scene.getStylesheets()!!.add(source) }
        window.setTitle(title)
        window.setScene(scene)
        window.setMinWidth(420.0)
        window.setMinHeight(320.0)
        window.setOnCloseRequest((event) { event!!.consume() this.requestClose() })
        build()
        if !closing { window.show() }
      })
      task.await()
    } finally {
      try { terminations.await() }
      finally { terminations.close() finished.close() }
    }
  }

  public Void root(FxNode node) {
    checkFxThread()
    var children = container!!.getChildren()!!
    children.clear()
    children.add(node.node())
  }

  public Scene scene() {
    checkFxThread()
    var current = activeScene
    if current == null || closing { throw Exception(message: "GUI scene is unavailable") }
    current
  }

  public FxNode text() { checkFxThread() FxNode(application: this, node: labelNew()) }
  public FxNode button() { checkFxThread() FxNode(application: this, node: buttonNew()) }
  public FxNode input() { checkFxThread() FxNode(application: this, node: textFieldNew()) }
  public FxNode textArea() { checkFxThread() FxNode(application: this, node: textAreaNew()) }
  public FxNode toggle() { checkFxThread() FxNode(application: this, node: checkBoxNew()) }
  public FxNode adopt(Node node) { checkFxThread() FxNode(application: this, node: node, managed: false) }
  public FxNode component() {
    checkFxThread()
    var pane = stackPaneNew()
    pane.getStyleClass()!!.add("norm-component")
    FxNode(application: this, node: pane)
  }

  public Void interceptClose(Function<Boolean()> callback) { checkFxThread() closeRequested = callback }
  public Void hide() { checkFxThread() stage?.hide() }
  public Void show() { checkFxThread() if !closing { stage?.show() stage?.setIconified(false) stage?.toFront() } }
  public Void requestClose() {
    checkFxThread()
    var callback = closeRequested
    if callback == null || callback() { this.close() }
  }
  public Void close() { checkFxThread() this.finish(null) }
  public Void later(Function<Void()> action) { platformRunLater(() { this.dispatch(action) }) }

  public Void trackTermination(Task<Unit> termination) {
    checkFxThread()
    if closing { throw Exception(message: "GUI application is closed") }
    terminations.track(termination)
  }

  public Void reportFailure(String message) {
    checkFxThread()
    if closing { return }
    printLine(message)
    var alert = alertNew(AlertAlertType.ERROR)
    alert.initOwner(stage)
    alert.setTitle("操作失败")
    alert.setHeaderText(null)
    alert.setContentText(message)
    alert.setOnHidden((event) {
      List<Alert> visible = List<>()
      for error : errors { if error != alert { visible.add(error) } }
      errors = visible
    })
    errors.add(alert)
    alert.show()
  }

  Void dispatch(Function<Void()> action) {
    if closing { return }
    Boolean returned = false
    try { action() returned = true }
    catch Exception error { this.finish(error) }
    finally {
      if !returned && !closing { this.finish(Exception(message: "GUI callback aborted")) }
    }
  }

  private Void finish(Exception? failure) {
    if closing { return }
    closing = true
    var result = failure
    Boolean cleaned = false
    try {
      var cleanup = cleanupAction
      if cleanup != null { cleanup() }
      cleaned = true
    } catch Exception error { if result == null { result = error } }
    finally {
      if result == null && !cleaned { result = Exception(message: "GUI cleanup aborted") }
      for error : errors { error.close() }
      stage?.close()
      activeScene = null
      if result == null { finished.succeed(Unit.Value) }
      else { finished.fail(result) }
    }
  }
}
