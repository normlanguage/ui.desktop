package ui.fx

import ui.WidgetRole
import theme.Theme
import theme.Tone
import theme.Appearance
import theme.ControlState
import ui.UiConfiguration
import ui.TextDirection
import fx.graphics.Node
import fx.graphics.NodeOrientation

String fxConfigurationStyle(UiConfiguration configuration) {
  var escaped = StringBuilder()
  for character : configuration.fontFamily.codePoints() {
    if character == '\\' || character == '"' { escaped.append("\\") escaped.append(character) }
    else { escaped.append(character) }
  }
  "-fx-font-family:\"" + escaped.toString() + "\";-fx-font-size:" + configuration.fontSize.toString() + "px;"
}

Void fxConfigureNode(Node node, UiConfiguration configuration) {
  node.setNodeOrientation(if configuration.direction == TextDirection.LeftToRight { NodeOrientation.LEFT_TO_RIGHT } else { NodeOrientation.RIGHT_TO_LEFT })
}

String fxThemeStyle(Theme snapshot, WidgetRole role) {
  var primary = snapshot.control(tone: Tone.Primary, appearance: Appearance.Filled)
  var danger = snapshot.control(tone: Tone.Danger, appearance: Appearance.Filled)
  String foreground = switch role {
    case Muted { break snapshot.textMuted.hex() }
    case Primary { break primary.normal.foreground.hex() }
    case Destructive { break danger.normal.foreground.hex() }
    case _ { break snapshot.surface.foreground.hex() }
  }
  String base = switch role {
    case Primary { break primary.normal.background.hex() }
    case Destructive { break danger.normal.background.hex() }
    case _ { break snapshot.surface.background.hex() }
  }
  String style = "-norm-canvas:" + snapshot.canvas.background.hex() + ";"
    + "-norm-surface:" + snapshot.surface.background.hex() + ";"
    + "-norm-surface-raised:" + snapshot.surfaceRaised.background.hex() + ";"
    + "-norm-outline:" + snapshot.outline.hex() + ";"
    + "-norm-divider:" + snapshot.divider.hex() + ";"
    + "-norm-text:" + snapshot.surface.foreground.hex() + ";"
    + "-norm-text-muted:" + snapshot.textMuted.hex() + ";"
    + "-fx-base:" + base + ";-fx-background:" + snapshot.surface.background.hex() + ";"
    + "-fx-control-inner-background:" + snapshot.surfaceRaised.background.hex() + ";"
    + "-fx-text-base-color:" + foreground + ";-fx-text-fill:" + foreground + ";"
    + "-fx-focus-color:" + primary.focusRing.hex() + ";-fx-faint-focus-color:transparent;"
  if role == WidgetRole.Card { style = style + "-fx-background-color:-norm-surface-raised;" }
  style
}

String toneName(Tone tone) {
  switch tone {
    case Neutral { break "neutral" }
    case Primary { break "primary" }
    case Secondary { break "secondary" }
    case Success { break "success" }
    case Warning { break "warning" }
    case Danger { break "danger" }
    case Info { break "info" }
  }
}

String appearanceName(Appearance appearance) {
  switch appearance {
    case Filled { break "filled" }
    case Soft { break "soft" }
    case Outlined { break "outlined" }
    case Plain { break "plain" }
  }
}

String themeCss(Theme theme) {
  var css = "-norm-canvas: " + theme.canvas.background.hex() + ";"
  css = css + "-norm-text: " + theme.canvas.foreground.hex() + ";"
  css = css + "-norm-surface: " + theme.surface.background.hex() + ";"
  css = css + "-norm-surface-raised: " + theme.surfaceRaised.background.hex() + ";"
  css = css + "-norm-divider: " + theme.divider.hex() + ";"
  css = css + "-norm-muted: " + theme.textMuted.hex() + ";"
  css = css + "-norm-outline: " + theme.outline.hex() + ";"
  css = css + "-norm-focus: " + theme.control(tone: Tone.Primary).focusRing.hex() + ";"
  css = css + "-norm-scrim: " + theme.scrim.hex() + ";"
  var tones = [Tone.Neutral, Tone.Primary, Tone.Secondary, Tone.Success, Tone.Warning, Tone.Danger, Tone.Info]
  var appearances = [Appearance.Filled, Appearance.Soft, Appearance.Outlined, Appearance.Plain]
  for tone : tones {
    for appearance : appearances {
      for selected : [false, true] {
      var palette = theme.control(tone, appearance, selected)
      var prefix = "-norm-" + toneName(tone) + "-" + appearanceName(appearance)
      if selected { prefix = prefix + "-selected" }
      css = css + stateCss(prefix: prefix + "-normal", state: palette.normal)
      css = css + stateCss(prefix: prefix + "-hovered", state: palette.hovered)
      css = css + stateCss(prefix: prefix + "-pressed", state: palette.pressed)
      css = css + stateCss(prefix: prefix + "-disabled", state: palette.disabled)
      }
    }
  }
  css
}

private String stateCss(String prefix, ControlState state) {
  prefix + "-background: " + state.background.hex() + ";" + prefix + "-foreground: " + state.foreground.hex() + ";" + prefix + "-border: " + state.border.hex() + ";"
}
