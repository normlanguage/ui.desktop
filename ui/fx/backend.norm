package ui.fx

import ui.UiScheduler
import ui.RenderBackend
import ui.LayoutBackend
import ui.LayoutSpec
import ui.ViewContent
import ui.RenderNode
import ui.ThemedRenderNode
import ui.ConfiguredRenderNode
import ui.UiConfiguration
import ui.WidgetRole
import theme.Theme
import ui.TextFieldRenderNode
import ui.TextFieldHandle
import ui.TextFieldControl
import ui.View
import ui.Binding

import std.core.Exception
import std.core.Unit
import std.concurrent.Task

class JavaFxScheduler implements UiScheduler {
  private FxApplication application
  JavaFxScheduler(FxApplication application) { this.application = application }

  Void track(Task<Unit> termination) { application.trackTermination(termination) }

  Void later(Function<Void()> action) { application.later(action) }
  Void report(Exception error) { application.reportFailure(error.message) }
}

class JavaFxBackend implements LayoutBackend {
  private FxApplication application

  JavaFxBackend(FxApplication application) { this.application = application }
  FxApplication fxApplication() { application }

  RenderNode createLayout(LayoutSpec specification) { FxLayoutRenderNode(application, specification) }

  RenderNode create(ViewContent content) {
    FxNode node = switch content {
      case Text(_) { break application.text() }
      case Button(_, _) { break application.button() }
      case Input(_, _, _) { break application.input() }
      case Multiline(_, _, _, _) { break application.textArea() }
      case Toggle(_, _) { break application.toggle() }
      case Component(_, _) { break application.component() }
      case Native(_) { throw Exception(message: "native views are created by their descriptor") }
      case WidgetObject(_) { break application.component() }
    }
    FxRenderNode(node)
  }
}

interface FxNodePeer extends RenderNode {
  FxNode fxNode()
}

class FxRenderNode implements TextFieldRenderNode, FxNodePeer, ThemedRenderNode, ConfiguredRenderNode {
  private FxNode peer

  private Theme? snapshot = null
  private UiConfiguration settings = UiConfiguration()
  private WidgetRole themeRole = WidgetRole.Default

  Void theme(Theme? theme) {
    snapshot = theme
    peer.nativeNode().setStyle((if theme != null { fxThemeStyle(snapshot: theme, role: themeRole) } else { "" }) + fxConfigurationStyle(settings))
  }

  Void configure(UiConfiguration configuration) {
    settings = configuration
    fxConfigureNode(node: peer.nativeNode(), configuration: configuration)
    var currentTheme = snapshot
    peer.nativeNode().setStyle((if currentTheme != null { fxThemeStyle(snapshot: currentTheme, role: themeRole) } else { "" }) + fxConfigurationStyle(configuration))
  }

  FxRenderNode(FxNode peer) { this.peer = peer }

  FxNode fxNode() { return peer }
  TextFieldHandle textFieldHandle() { TextFieldHandle(FxTextFieldControl(peer)) }

  Void update(View view) {
    var currentTheme = snapshot
    if currentTheme != null && themeRole != view.role { peer.nativeNode().setStyle(fxThemeStyle(snapshot: currentTheme, role: view.role) + fxConfigurationStyle(settings)) }
    themeRole = view.role
    peer.enabled(view.enabled)
    String role = switch view.role {
      case Default { break "default" }
      case Title { break "title" }
      case Muted { break "muted" }
      case Primary { break "primary" }
      case Destructive { break "destructive" }
      case Card { break "card" }
    }
    String identity = switch view.key {
      case Named(String value) { break value }
      case Id(Integer value) { break value.toString() }
      case _ { break "" }
    }
    peer.appearance(role: role, key: identity)
    switch view.content {
      case Text(String text) { peer.text(text) }
      case Button(String text, Function<Void()> action) {
        peer.text(text)
        peer.onAction(action)
      }
      case Input(String placeholder, Binding<String>? text, Function<Void(String)> submit) {
        peer.placeholder(placeholder)
        if text != null {
          peer.text(text.value)
          peer.onText((value) { text.value = value })
        } else {
          peer.onText((value) {})
        }
        peer.onAction(() { submit(this.textFieldHandle().text) })
      }
      case Multiline(String placeholder, Binding<String> text, Integer rows, Boolean editable) {
        peer.placeholder(placeholder)
        peer.text(text.value)
        peer.onText((String value) { text.value = value })
        peer.textAreaConfiguration(rows: rows, editable: editable)
      }
      case Toggle(String text, Binding<Boolean> checked) {
        peer.text(text)
        peer.checked(checked.value)
        peer.onToggle((value) { checked.value = value })
      }
      case _ {}
    }
  }

  Void children(List<RenderNode> children) {
    List<FxNode> nodes = []
    for child : children { nodes.add(fxHandle(child)) }
    peer.children(nodes)
  }

  Void close() { peer.close() }
}

class FxTextFieldControl implements TextFieldControl {
  private FxNode peer
  FxTextFieldControl(FxNode peer) { this.peer = peer }
  String readText() {
    peer.readText()
  }
  Void clear() { peer.clear() }
  Void focus() { peer.focus() }
}

FxNode fxHandle(RenderNode node) {
  return switch node {
    case FxNodePeer mounted { break mounted.fxNode() }
    case _ { throw Exception(message: "node belongs to a different rendering backend") }
  }
}
