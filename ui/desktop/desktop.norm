package ui.desktop

import ui.Widget
import ui.ViewScope
import ui.View
import ui.ViewContent
import ui.Renderer
import ui.describe

import di.Container
import di.startContainer
import std.core.Unit

value DesktopApp<C = Unit> {
  String title
  Widget home
  C? config = null
  Double width = 760.0
  Double height = 680.0
  Function<Void(CloseRequest)>? onCloseRequested = null

  Void run() {
    var configuration = this.config
    var container = if configuration == null { Container() } else { startContainer<C>(configuration) }
    try {
      runApp(title: title, body: (scope) { describe(home) }, container: container, width: width, height: height, onCloseRequested: onCloseRequested)
    } finally {
      container.close()
    }
  }
}

Void runApp<C>(DesktopApp<C> app) {
  app.run()
}

Void runApp(String title, Function<View(ViewScope)> body, Container? container = null, Double width = 760.0, Double height = 680.0, Function<Void(CloseRequest)>? onCloseRequested = null) {
  var application = FxApplication(title: title, width: width, height: height)
  var renderer = Renderer(backend: JavaFxBackend(application), scheduler: JavaFxScheduler(application), container: container)
  application.run(build: () {
    renderer.render(View(content: ViewContent.Component(type: "application", body: (scope) {
      var guard = onCloseRequested
      if guard != null { application.interceptClose((request) { scope.execute(() { guard(request) }) }) }
      body(scope)
    })))
    application.root(fxHandle(renderer.node()))
  }, dispose: renderer.close)
}
